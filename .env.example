# 상대 경로: .env.example
#
# 본 파일은 commit 대상. 실제 값(특히 API 키)은 .env (gitignore) 에 채워서 사용.
# 신규 팀원/CI 가 본 파일을 .env 로 복사한 뒤 값 채우면 기동 가능.
#
# 사용 예:
#   cp .env.example .env
#   # 키 값 채운 뒤
#   PYTHONPATH=. .venv/bin/python -m uvicorn app.main:app --reload --port 8000

# ===== LLM (OpenAI) — 필수 =====
# https://platform.openai.com 에서 발급
OPENAI_API_KEY=sk-REPLACE-WITH-YOUR-OPENAI-KEY

# 모델 티어링(보고서 §4-2-1b·§9): 쉬운 일=싼 모델, 답·검증=상위/추론형
# 분류·요약·문맥생성 = gpt-4o-mini / 답작성(writer) = gpt-5.1 / 검증 = o4-mini(추론형)
ROUTER_MODEL=gpt-4o-mini          # 라우터(의도 분류) — 쉬운 작업
SUMMARY_MODEL=gpt-4o-mini         # 사전요약 생성(빌드 타임)
CONTEXTUAL_MODEL=gpt-4o-mini      # Contextual 문맥 한 줄 생성(인제스트)
QA_MODEL=gpt-5.1                  # writer(답 작성) — 품질이 핵심이라 상위 모델
MACRO_MODEL=gpt-4o-mini           # 거시 결합
VERIFICATION_MODEL=o4-mini        # 검증(근거 채점) — 추론형, 샘플링

# ===== OpenDART (주 데이터) — 필수 =====
# https://opendart.fss.or.kr 에서 무료 발급 (이메일 즉시, 일 1만건)
DART_API_KEY=REPLACE-WITH-YOUR-DART-KEY

# ===== 한국은행 ECOS (보조: 환율/금리/국고채/KOSPI) — 필수 =====
# https://ecos.bok.or.kr 에서 무료 발급
ECOS_API_KEY=REPLACE-WITH-YOUR-ECOS-KEY

# ===== 임베딩 (OpenAI) =====
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ===== 검증 임계값 (grounded_score → verdict) =====
VERIFY_PASS_MIN=0.7
VERIFY_PARTIAL_MIN=0.4

# ===== 저장 경로 =====
CHROMA_DIR=./data/chroma       # 벡터DB(코퍼스) 영속 경로 — 약 6.8만 청크 이미 적재됨(재적재 금지)
SQLITE_PATH=./data/app.db      # 거시 캐시 등
